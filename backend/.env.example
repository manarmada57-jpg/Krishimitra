# KrishiMitra Backend — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.

PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# For local development: mongodb://127.0.0.1:27017/krishimitra
# For production (MongoDB Atlas):
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/krishimitra?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/krishimitra

# ─── JWT Authentication Secrets (min 32 random characters) ───────────────────
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret_32_chars_min
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret_32_chars_min

# ─── AES-256-GCM Encryption Key (64-char hex = 32 bytes) ────────────────────
ENCRYPTION_KEY=replace_with_64_hex_chars_0123456789abcdef0123456789abcdef0000

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── SMTP / Email (optional) ─────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@krishimitra.org

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# Obtain a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Frontend URL (CORS) ─────────────────────────────────────────────────────
# Set to your deployed frontend domain in production (e.g. https://krishimitra.vercel.app)
FRONTEND_URL=http://localhost:5173

# ─── ISRO VEDAS Satellite Integration (optional) ─────────────────────────────
# Register at https://vedas.sac.gov.in/vconsole/ for a free API token.
# When set, /api/crops/satellite-insights returns real dataSource: "VEDAS_LIVE".
# Leave blank to use realistic coordinate-seeded simulation.
VEDAS_BASE_URL=https://vedas.sac.gov.in/api/v1
VEDAS_API_KEY=your_vedas_api_key_here
